{
  "name": "tishaan-game-zone",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "A mobile-friendly arcade with independent browser games.",
  "scripts": {
    "start": "node scripts/catalog.mjs && node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "preview": "node scripts/serve.mjs --dist",
    "catalog": "node scripts/catalog.mjs",
    "test:hub": "node tests/hub-browser.mjs",
    "test:candy": "node tests/candy-browser.mjs",
    "test:citadel": "node tests/citadel-browser.mjs",
    "test:studio": "node tests/studio-browser.mjs",
    "test:features": "node tests/features-browser.mjs"
  }
}
